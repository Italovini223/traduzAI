generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══ APP (Tenant) ═══

model Store {
  id                Int       @id @default(autoincrement())
  nuvemshopId       String    @unique
  name              String?
  domain            String?
  email             String?
  accessToken       String?
  plan              String    @default("starter")
  trialEndsAt       DateTime?
  uninstalledAt     DateTime? // setado pelo webhook app/uninstalled (null = app instalado)
  stripeCustomerId  String?
  partnerId         String?
  partnerName       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  subscription      Subscription?
  profile           StoreProfile?
  termsAcceptances  TermsAcceptance[]
  supportTickets    SupportTicket[]
  translationConfig StoreTranslationConfig?
  localeRules       StoreLocaleRule[]
  orderRecords      OrderRecord[]
  translationOverrides StoreTranslationOverride[]
  bannerOverrides   StoreBannerOverride[]
  countryGlossaryTerms StoreCountryGlossaryTerm[]
  @@map("stores")
}

model StoreProfile {
  id        Int      @id @default(autoincrement())
  storeId   Int      @unique
  store     Store    @relation(fields: [storeId], references: [id])
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("store_profiles")
}

model Subscription {
  id                    Int       @id @default(autoincrement())
  storeId               Int       @unique
  store                 Store     @relation(fields: [storeId], references: [id])
  stripeSubscriptionId  String?
  status                String    @default("none")
  planKey               String?
  billingInterval       String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@map("subscriptions")
}

model Invoice {
  id               Int      @id @default(autoincrement())
  storeId          Int
  stripeInvoiceId  String   @unique
  amountPaid       Float
  currency         String   @default("brl")
  status           String
  invoiceUrl       String?
  invoicePdf       String?
  periodStart      DateTime?
  periodEnd        DateTime?
  createdAt        DateTime @default(now())
  @@map("invoices")
}

model TermsVersion {
  id          Int       @id @default(autoincrement())
  version     String
  title       String
  content     String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  acceptances TermsAcceptance[]
  @@map("terms_versions")
}

model TermsAcceptance {
  id              Int          @id @default(autoincrement())
  storeId         Int
  store           Store        @relation(fields: [storeId], references: [id])
  termsVersionId  Int
  termsVersion    TermsVersion @relation(fields: [termsVersionId], references: [id])
  acceptedAt      DateTime     @default(now())
  @@unique([storeId, termsVersionId])
  @@map("terms_acceptances")
}

// ═══ ADMIN ═══

model AdminUser {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("suporte")
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     AdminSession[]
  @@map("admin_users")
}

model AdminSession {
  id        Int       @id @default(autoincrement())
  adminId   Int
  admin     AdminUser @relation(fields: [adminId], references: [id])
  token     String
  ipAddress String?
  userAgent String?
  isActive  Boolean   @default(true)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  @@map("admin_sessions")
}

model AdminPlan {
  id               Int      @id @default(autoincrement())
  appId            String
  name             String
  stripePriceIds   Json     @default("{}")
  features         Json     @default("{}")
  price            Json     @default("{}")
  commissionRate   Float    @default(0)
  revenueShareRate Float    @default(0)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([appId, name])
  @@map("admin_plans")
}

model AdminConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  group     String   @default("system")
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("admin_configs")
}

model AdminLog {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ipAddress String?
  severity  String   @default("info")
  createdAt DateTime @default(now())
  @@map("admin_logs")
}

model AdminCommission {
  id               Int      @id @default(autoincrement())
  partnerId        String
  partnerName      String?
  storeId          Int
  invoiceId        String
  amount           Float
  commissionRate   Float
  commissionAmount Float
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([invoiceId]) // 1 comissão por fatura — backstop contra reentrega concorrente
  @@map("admin_commissions")
}

model AdminCoupon {
  id                    Int       @id @default(autoincrement())
  code                  String    @unique
  type                  String
  value                 Float
  maxRedemptions        Int?
  timesRedeemed         Int       @default(0)
  validUntil            DateTime?
  isActive              Boolean   @default(true)
  stripeCouponId        String?
  stripePromotionCodeId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@map("admin_coupons")
}

model AdminFaq {
  id          Int      @id @default(autoincrement())
  category    String   @default("geral")
  locale      String   @default("pt") // idioma da FAQ: pt | es
  question    String
  answer      String
  videoUrl    String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("admin_faqs")
}

// ─── Suporte (tickets) ─────────────────────────────────────────────────────
// Ticket aberto pela loja (tenant) no app; respondido pelo admin. Thread de
// mensagens (author = store | admin). Isolado por storeId.
model SupportTicket {
  id            Int             @id @default(autoincrement())
  storeId       Int
  subject       String?
  status        String          @default("open") // open | answered | closed
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([storeId])
  @@index([status, lastMessageAt(sort: Desc)])
  @@map("support_tickets")
}

model SupportMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  author    String   // store | admin
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ─── Tradução da vitrine + conversão de moeda (traduzAI) ───────────────────
// Config por loja (1:1) + regras país→idioma/moeda (1:N). Cache de tradução
// e de câmbio são globais (não por loja) — texto→tradução e taxas de câmbio
// não são dados sensíveis de tenant, e compartilhar reduz custo de API real.
model StoreTranslationConfig {
  id             Int      @id @default(autoincrement())
  storeId        Int      @unique
  store          Store    @relation(fields: [storeId], references: [id])
  enabled        Boolean  @default(false)
  sourceLanguage String   @default("pt") // idioma original do conteúdo da loja
  baseCurrency   String   @default("BRL") // moeda original dos preços
  translateImages Boolean @default(false) // opt-in — chama Google Vision (custo externo)
  pickerPosition String   @default("bottom-left") // posição do seletor de bandeiras na vitrine
  pickerColor    String   @default("#1a73e8") // cor de destaque do seletor de bandeiras
  scriptId       String?  // id retornado pela Nuvemshop Script API
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("store_translation_configs")
}

model StoreLocaleRule {
  id        Int      @id @default(autoincrement())
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  country   String   // ISO 3166-1 alpha-2, ex: "US"
  language  String   // ex: "en"
  currency  String   // ISO 4217, ex: "USD"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([storeId, country])
  @@map("store_locale_rules")
}

// Adaptação de dialeto/tom por PAÍS (não por idioma) — DeepL só tem um
// "ES" genérico, não distingue espanhol da Argentina/México/Espanha. Termo
// encontrado dentro de QUALQUER texto já traduzido pra esse país é
// substituído (ex.: "ustedes" -> "vos" pra AR) — diferente de
// StoreTranslationOverride, que corrige uma string EXATA inteira; aqui é
// find/replace de termo dentro de qualquer texto, aplicado em cima da
// tradução base (DeepL/cache/override), por isso a chave é o PAÍS, não o
// targetLang (AR e MX podem ter o mesmo targetLang "es" mas glossários
// diferentes).
model StoreCountryGlossaryTerm {
  id          Int      @id @default(autoincrement())
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  country     String   // ISO 3166-1 alpha-2, ex: "AR"
  findText    String   // termo a substituir na tradução (case-insensitive, borda de palavra)
  replaceText String   // termo substituto
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([storeId, country, findText])
  @@map("store_country_glossary_terms")
}

// Correção manual do lojista pra um texto traduzido específico — checada
// ANTES do TranslationCache/DeepL em POST /storefront/translate. Por loja
// (ao contrário do TranslationCache, que é global): o mesmo texto original
// pode existir em várias lojas com temas parecidos, e a correção de uma
// loja não deve "vazar" pra tradução automática de outra.
model StoreTranslationOverride {
  id           Int      @id @default(autoincrement())
  storeId      Int
  store        Store    @relation(fields: [storeId], references: [id])
  sourceHash   String   // sha256(sourceText) — mesmo cálculo do TranslationCache
  sourceText   String   // texto original (pt-BR), guardado pra exibir na lista do admin
  targetLang   String
  overrideText String   // tradução corrigida pelo lojista
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([storeId, sourceHash, targetLang])
  @@map("store_translation_overrides")
}

// Banner traduzido manualmente pelo lojista (imagem de verdade, não overlay
// de canvas) — checado ANTES do OCR/Vision em POST /storefront/translate-image.
// Por loja, igual StoreTranslationOverride: a mesma URL de imagem pode
// existir em lojas diferentes com o mesmo tema, a substituição de uma loja
// não deve valer pra outra.
model StoreBannerOverride {
  id                Int      @id @default(autoincrement())
  storeId           Int
  store             Store    @relation(fields: [storeId], references: [id])
  originalImageHash String   // sha256(URL da imagem original) — mesmo padrão do ImageTextCache
  originalImageUrl  String   // guardado só pra exibir no admin qual banner está sendo substituído
  targetLang        String
  replacementImage  String   @db.Text // data: URL base64 da imagem enviada pelo lojista
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([storeId, originalImageHash, targetLang])
  @@map("store_banner_overrides")
}

model TranslationCache {
  id             Int      @id @default(autoincrement())
  sourceHash     String   // sha256(sourceText)
  sourceLang     String
  targetLang     String
  sourceText     String
  translatedText String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([sourceHash, sourceLang, targetLang])
  @@map("translation_cache")
}

model ExchangeRate {
  id            Int      @id @default(autoincrement())
  baseCurrency  String
  quoteCurrency String
  rate          Float
  fetchedAt     DateTime @default(now())
  @@unique([baseCurrency, quoteCurrency])
  @@map("exchange_rates")
}

// Cache de IP -> pais (fallback via API externa quando geoip-lite, base local,
// nao reconhece o IP). country null = lookup externo falhou/sem resultado,
// cacheado com TTL curto pra tentar de novo logo (ver config/geoip.js).
model IpGeoCache {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  country   String?
  fetchedAt DateTime @default(now())
  @@map("ip_geo_cache")
}

// Pedidos pagos, gravados via webhook order/paid — fonte do mapa/gráfico de
// vendas por país no Dashboard. Populado de forma best-effort (nunca bloqueia
// o webhook); ausência de linha != ausência de venda se o webhook falhar.
model OrderRecord {
  id               Int      @id @default(autoincrement())
  storeId          Int
  store            Store    @relation(fields: [storeId], references: [id])
  nuvemshopOrderId String
  country          String?  // ISO 3166-1 alpha-2 — shipping_address, fallback billing_country
  amount           Float    // order.total (nao total_paid_by_customer, que nao existe na resposta real)
  currency         String
  paidAt           DateTime
  createdAt        DateTime @default(now())
  @@unique([storeId, nuvemshopOrderId])
  @@index([storeId, paidAt])
  @@map("order_records")
}

// Cache global (como TranslationCache) de blocos de texto detectados por OCR
// numa imagem + tradução — evita rechamar a Vision API pra imagem repetida
// (mesmo banner aparece em várias páginas/lojas). blocks é o array retornado
// por VisionService.detectTextBlocks() + translatedText por bloco.
model ImageTextCache {
  id           Int      @id @default(autoincrement())
  imageUrlHash String   // sha256(imageUrl)
  targetLang   String
  blocks       Json     // [{ text, translatedText, rect:{x,y,width,height}, imageWidth, imageHeight, bgColor }]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([imageUrlHash, targetLang])
  @@map("image_text_cache")
}
