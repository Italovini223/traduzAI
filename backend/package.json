  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "sharp": "^0.33.5",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^6.19.2"
  }
