{
  "name": "traduzai-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "npx prisma generate && npx prisma migrate deploy",
    "start": "node src/server.js",
    "test": "node --test src/__tests__/*.test.js",
    "db:push": "npx prisma db push",
